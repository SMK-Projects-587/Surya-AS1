{
  "name": "project",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint:js": "eslint src/js",
    "lint:scss": "stylelint \"src/scss/**/*.scss\"",
    "lint": "npm run lint:js && npm run lint:scss",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^15.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.4.0",
    "sass": "^1.80.0",
    "stylelint": "^16.0.0",
    "stylelint-config-recess-order": "^5.0.0",
    "stylelint-config-standard-scss": "^13.0.0",
    "stylelint-order": "^6.0.0",
    "vite": "^6.0.0"
  },
  "lint-staged": {
    "src/js/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/scss/**/*.scss": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{html,json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
